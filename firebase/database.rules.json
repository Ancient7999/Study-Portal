{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        "cursors": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'updatedAt']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('updatedAt').isNumber()"
          }
        },
        "presence": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['state', 'updatedAt']) && newData.child('state').isString() && newData.child('updatedAt').isNumber()"
          }
        }
      }
    }
  }
}
