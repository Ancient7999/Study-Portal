rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt', 'mood',
          'level', 'questionsAnswered'
        ])
        && isString(request.resource.data.displayName, 1, 16)
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.questionsAnswered is number
        && request.resource.data.questionsAnswered >= 0
        && request.resource.data.questionsAnswered <= 1000000
        && (!('bio' in request.resource.data) || isString(request.resource.data.bio, 0, 160));
      allow delete: if isSelf(uid);
    }

    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'subjectId', 'materialId', 'form', 'percent', 'createdAt'])
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && isString(request.resource.data.subjectId, 1, 64)
        && isString(request.resource.data.materialId, 1, 64)
        && isString(request.resource.data.form, 1, 8);
      allow update, delete: if false;
    }

    match /leaderboards/{materialId}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.bestPercent is number
        && request.resource.data.bestPercent >= 0
        && request.resource.data.bestPercent <= 100;
      allow delete: if isSelf(uid);
    }

    // Solo quiz progress (mastery, achievements, form best %, settings)
    match /progress/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'mastery', 'dnsa', 'achievements', 'forms', 'pomodoroEnabled', 'friends', 'updatedAt'
        ])
        && request.resource.data.updatedAt is number
        && (!('pomodoroEnabled' in request.resource.data)
            || request.resource.data.pomodoroEnabled is bool)
        && (!('mastery' in request.resource.data) || request.resource.data.mastery is map)
        && (!('dnsa' in request.resource.data) || request.resource.data.dnsa is map)
        && (!('achievements' in request.resource.data) || request.resource.data.achievements is map)
        && (!('forms' in request.resource.data) || request.resource.data.forms is map)
        && (!('friends' in request.resource.data)
            || (request.resource.data.friends is list
                && request.resource.data.friends.size() <= 40))
        && request.resource.data.keys().size() <= 9;
      allow delete: if isSelf(uid);
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && isString(request.resource.data.title, 1, 80);
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && isString(request.resource.data.text, 1, 500)
          && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt']);
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
